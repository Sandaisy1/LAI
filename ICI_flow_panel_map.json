{
  "species": "mouse",
  "experiment": "Internation_cell_immune",
  "purpose": "find His-tagged target cells; immune subsets use P1 T/NK, P2 B (CD19/CD27/IgM/IgG), P3 myeloid gates with the markers on this sheet",
  "data_dir": "E:/R/Internation cell immune",
  "file_glob": "*_unmixed.fcs",
  "filename_regex": "^(?:ZZX[_-]?)?(EV|H)[-_]?([123])(?:[-_]([12]))?[-_ ]+(?:PANEL[-_ ]?)?P?0?([123])[-_ ].*(unmixed|raw)\\.fcs$",
  "groups": ["EV", "H"],
  "replicates": ["1", "2", "3"],
  "cohort": "ZZX",
  "comparison": "H_vs_EV",
  "panels_to_run": ["P1", "P2", "P3"],
  "qc": {
    "viability_marker": "L/D",
    "leukocyte_marker": "CD45",
    "target_marker": "His",
    "require_cd45": false,
    "exclude_from_dr": ["L/D", "CD45"],
    "asinh_cofactor": 150
  },
  "fluorochrome_aliases": {
